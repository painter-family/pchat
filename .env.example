# Copy this file to .env.local and follow the Google sign-in setup in README.md.
# Generate AUTH_SECRET locally; never commit real secrets.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Default: the local Node app uses the remote development D1/R2 bindings.
PCHAT_STORAGE=cloudflare

# Optional absolute directory for offline SQLite and uploads (PCHAT_STORAGE=local).
# Leave blank to use ./data. Keep it outside any public web directory.
PCHAT_DATA_DIR=
